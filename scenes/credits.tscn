content_margin_left = 40.0
content_margin_top = 26.0
content_margin_right = 40.0
content_margin_bottom = 26.0

[node name="Credits" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_credits")

[node name="Felt" type="ColorRect" parent="."]

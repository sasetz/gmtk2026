[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/credits.gd" id="1_credits"]

[sub_resource type="StyleBoxFlat" id="sb_credits"]
bg_color = Color(0.06, 0.13, 0.11, 0.98)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14

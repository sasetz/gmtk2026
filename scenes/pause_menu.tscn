anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.02, 0.05, 0.04, 0.75)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -230.0
offset_top = -95.0
offset_right = 230.0
offset_bottom = 95.0
grow_horizontal = 2
grow_vertical = 2

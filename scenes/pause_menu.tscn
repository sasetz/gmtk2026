[ext_resource type="SpriteFrames" path="res://assets/art/buttons/button_white_cat.tres" id="3_cat"]

[sub_resource type="StyleBoxFlat" id="sb_pause"]
bg_color = Color(0.06, 0.13, 0.11, 0.98)
